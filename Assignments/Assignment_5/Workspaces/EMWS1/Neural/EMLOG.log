MPRINT(EM_ASSESS):   BASELIFT = AVGNUMRESP / ( RESPRATE * 173/20 );
MPRINT(EM_ASSESS):   END;
MPRINT(EM_ASSESS):   ELSE BASELIFT = .;
MPRINT(EM_ASSESS):   IF C_NUMOBS > 0 THEN CBASELIFT = C_AVGNUM_RESP / (RESPRATE * ((20-GROUP+1)* 173/20));
MPRINT(EM_ASSESS):   ELSE CBASELIFT = .;
