EVENTS1000 NONEVENTS1 - NONEVENTS1000 0 FIRSTIN1 - FIRSTIN1000 . LASTIN1 - LASTIN1000 . RESPRATE 0.3757225434 _NEVENTS 65 _NNONEVENTS 108 TARGET "NTARGET" ;
