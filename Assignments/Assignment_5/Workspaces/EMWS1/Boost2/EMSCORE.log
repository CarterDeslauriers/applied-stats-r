36141     +**
36142     +** ARGUMENTS: DATA=  data with which to evaluate interaction.
36143     +**                   Typically training data.
36144     +**            MODEL= Model data set from SAVE MODEL= option
36145     +**                   of PROC ARBORETUM  (or SPLIT, FOREST, TREEBOOST)
36146     +**            OUTDS= output data set from this macro.
36147     +**                   Contains two variables:
36148     +**                   NAME   containing name of input variable
36149     +**                   H      containing the H statistic for interaction.
36150     +**
36151     +** DETAILS:   In Predictive Models via Rule Ensembles the authors
36152     +**            define statistic Hj that will be greater than 0 to
36153     +**            the extant that input variable j interacts with some
36154     +**            other variable (section 8.1, equation 45 ).
36155     +**            Macro COMPUTE_IACT_H computes Hj for all variables
36156     +**            used as a primary splitting rule in the model.
36157     +**            The computation of interactions is time consuming.
36158     +**            The user might therefore consult Hj before selecting
36159     +**            which interactions to compute.
36160     +**
36161     +** REFERENCE: Jerome H. Friedman and Bogdan E. Popescu
36162     +**                  Predictive Models via Rule Ensembles
36163     +**                  28 Feb 2005
36164     +**                  http://www.stat-stanford.edu/~jhf
36165     +**************************************************************************;
36167     +    %do v=1 %to &ni;
36168     +        proc arbor proc=treeboost inmodel=&model;
36169     +            makemacro importantid=&v  var=var;
36170     +            partialdep data=&data out=vds(keep= p_: &var) var= (&var);
36171     +            partialdep data=&data out=eds(keep= p_:) exceptvar= (&var);
36172     +        quit;
36174     +        %let predvar=;
36175     +        %let dsid=%sysfunc(open(&EM_DEC_DECMETA(where=(_TYPE_='PREDICTED'))));
36176     +        %let varnum =%sysfunc(varnum(&dsid, VARIABLE));
36177     +        %do %while(^ %sysfunc(fetch(&dsid)));
36178     +           %let variable = %sysfunc(getvarc(&dsid, &varnum));
36179     +           %let predvar = &predvar &variable;
36180     +        %end;
36181     +        %let dsid = %sysfunc(close(&dsid));
36183     +        data fds;  set fds;  keep &predvar; run;
36184     +        data vds;  set vds;  keep &predvar; run;
36185     +        data eds;  set eds;  keep &predvar; run;
36188     +        %compute_iact_sub(ds1=fds, ds2=vds, ds3=eds, nc=&nclasses, outds=h);
36190     +        /* generates table same size as training data -- too large to plot; removing for now
36191     +        %generatePartialDependencyTable(iteration=&v, ds1=vds, var=&var); */
36193     +        data h;
36194     +             set h;
36195     +             length name $ 32;
36196     +             name = "&var";
36197     +        run;
36198     +        data &outds;
36199     +          set
36200     +              %if &v ne 1 %then %do;
36201     +                  &outds
36202     +              %end;
36203     +               h;
36204     +        run;
36206     +    %end;
36207     +%mend;
36209     +%macro compute_iact_sub(ds1=, ds2=, ds3=, nc=, outds=);
36211     +        %if &nc eq 0 %then %do;
36212     +             data ads; set &ds1; array r p_:; keep a; a = r(1); run;
36213     +             data bds; set &ds2; array r p_:; keep b; b = r(1); run;
36214     +             data cds; set &ds3; array r p_:; keep c; c = r(1); run;
36215     +             data mds; merge ads bds cds;         run;
36217     +             proc stdize data= mds method=mean out=sds;
36218     +                  var a b c;
36219     +             run;
36221     +             data &outds;
36222     +                 retain ss 0  sf 0;
36223     +                 set sds end=the_end;
36224     +                 keep H;
36226     +                 s = a - b - c;
36227     +                 ss = ss + s*s;
36228     +                 sf = sf + a * a;
36230     +                 if the_end ne 0 then do;
36231     +                    H = ss/sf;
36232     +                    output;
36233     +                 end;
36234     +             run;
36235     +        %end;
36237     +        %else %do;  * categorical response. nclasses > 0 ;
36238     +            data ads;
36239     +                 set &ds1;
36240     +                 array r{*} p_:;
36241     +                 keep a:;
36242     +                 %do j = 1 %to &nclasses;
36243     +                     a&j = r(&j);
36244     +                 %end;
36245     +              run;
36246     +              data bds;
36247     +                 set &ds2;
36248     +                 array r{*} p_:;
36249     +                 keep b:;
36250     +                 %do j = 1 %to &nclasses;
36251     +                     b&j = r(&j);
36252     +                 %end;
36253     +              run;
36254     +              data cds;
36255     +                 set &ds3;
36256     +                 array r{*} p_:;
36257     +                 keep c:;
36258     +                 %do j = 1 %to &nclasses;
36259     +                     c&j = r(&j);
36260     +                 %end;
36261     +              run;
36263     +              data mds;
36264     +                   merge ads bds cds;
36265     +              run;
36266     +              proc stdize data=mds method=mean out=sds;
36267     +                   var a: b: c:;
36268     +              run;
36270     +             data &outds;
36271     +                 retain ss 0  sf 0;
36272     +                 set sds end=the_end;
36273     +                 array ra a:;
36274     +                 array rb b:;
36275     +                 array rc c:;
36276     +                 keep H;
36278     +                 do j = 1 to dim(ra);
36279     +                    s = ra(j) - rb(j) - rc(j);
36280     +                    ss = ss + s*s;
36281     +                    sf = sf + ra(j) * ra(j);
36282     +                 end;
36284     +                 if the_end ne 0 then do;
36285     +                    H = ss/sf;
36286     +                    output;
36287     +                 end;
36288     +            run;
36289     +        %end;
36290     +%mend;
