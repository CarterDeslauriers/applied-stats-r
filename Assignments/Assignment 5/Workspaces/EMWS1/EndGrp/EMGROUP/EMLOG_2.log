MPRINT(MAKERESIDUALVARS):   put "*------------------------------------------------------------*;";
MPRINT(MAKERESIDUALVARS):   put "Length R_diagnosisM 8;";
MPRINT(MAKERESIDUALVARS):   put "Label R_diagnosisM='Residual: diagnosis=M';";
MPRINT(MAKERESIDUALVARS):   put "Length R_diagnosisB 8;";
MPRINT(MAKERESIDUALVARS):   put "Label R_diagnosisB='Residual: diagnosis=B';";
MPRINT(MAKERESIDUALVARS):   put "if ";
MPRINT(MAKERESIDUALVARS):   put " F_diagnosis ne 'M'";
MPRINT(MAKERESIDUALVARS):   put "and F_diagnosis ne 'B'";
MPRINT(MAKERESIDUALVARS):   put " then do;";
MPRINT(MAKERESIDUALVARS):   put "R_diagnosisM=.;";
MPRINT(MAKERESIDUALVARS):   put "R_diagnosisB=.;";
MPRINT(MAKERESIDUALVARS):   put "end;";
MPRINT(MAKERESIDUALVARS):   put "else do;";
MPRINT(MAKERESIDUALVARS):   put "R_diagnosisM= - P_diagnosisM;";
MPRINT(MAKERESIDUALVARS):   put "R_diagnosisB= - P_diagnosisB;";
MPRINT(MAKERESIDUALVARS):   put "select(F_diagnosis);";
MPRINT(MAKERESIDUALVARS):   put "when('M')R_diagnosisM= R_diagnosisM+1;";
MPRINT(MAKERESIDUALVARS):   put "when('B')R_diagnosisB= R_diagnosisB+1;";
MPRINT(MAKERESIDUALVARS):   put 'otherwise;';
MPRINT(MAKERESIDUALVARS):   put 'end;';
MPRINT(MAKERESIDUALVARS):   put 'end;';
MPRINT(MAKERESIDUALVARS):   run;
 
