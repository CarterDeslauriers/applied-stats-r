277049    +%macro embag(_tra=, _train=, _seed=, _freq=, _sumfreq=, _size=, _loop=);
277050    +  data &_tra;
277051    +    set &_train;
277052    +
277053    +    retain seed nremain ntrials ptrials -1;
277054    +    drop   seed nremain ntrials ptrials;
277055    +
277056    +    * If a frequency variable exists, do not export it                 ;
277057    +    %if %bquote(&_freq) ^=  %then %do;
277058    +        drop &_freq ;
277059    +        if &_freq eq . then return ;
277060    +        if &_freq <= 0 then return ;
277061    +    %end;
277062    +
277063    +    if ntrials lt 0 then do;     * Initialization                      ;
277064    +        seed = &_seed + &_loop;  * Seed depends on loop index          ;
277065    +        ntrials = round(&_size); * Number of observations to select    ;
277066    +        nremain = &_sumfreq;     * Obs to choose from = sum of freq var;
277067    +    end;
277068    +
277069    +    * The remaining observations are equally likely to be chosen       ;
277070    +    ptrials  = 1 / nremain %str(;);
277071    +
277072    +    * Incorporate any frequency variable into probability of selection ;
277073    +    %if %bquote(&_freq) ^=  %then ptrials   = &_freq * ptrials %str(;);
277074    +
277075    +    * Randomly set _resamp_ = number of times to output this obs       ;
277076    +    if ptrials < 1 then call ranbin( seed, ntrials, ptrials, _resamp_);
277077    +    else                _resamp_ = ntrials;
277078    +
277079    +    * Output training observation                                      ;
277080    +    if _resamp_ > 0 then output &_tra;
277081    +
277082    +    * Update number of observations still needed to output             ;
277083    +    ntrials = ntrials - _resamp_;
277084    +
277085    +    * If output enough observatoins, stop.                             ;
277086    +    if ntrials <= 0 then stop;
277087    +
277088    +    * Update number of observations remaining to choose from           ;
277089    +    %if %bquote(&_freq) ^=  %then nremain   = nremain  - &_freq %str(;);
277090    +    %else                         nremain   = nremain  -      1 %str(;);
277091    +
277092    +  run;
277093    +
277094    +%mend embag;
