35794     +%macro embag(_tra=, _train=, _seed=, _freq=, _sumfreq=, _size=, _loop=);
35795     +  data &_tra;
35796     +    set &_train;
35797     +
35798     +    retain seed nremain ntrials ptrials -1;
35799     +    drop   seed nremain ntrials ptrials;
35800     +
35801     +    * If a frequency variable exists, do not export it                 ;
35802     +    %if %bquote(&_freq) ^=  %then %do;
35803     +        drop &_freq ;
35804     +        if &_freq eq . then return ;
35805     +        if &_freq <= 0 then return ;
35806     +    %end;
35807     +
35808     +    if ntrials lt 0 then do;     * Initialization                      ;
35809     +        seed = &_seed + &_loop;  * Seed depends on loop index          ;
35810     +        ntrials = round(&_size); * Number of observations to select    ;
35811     +        nremain = &_sumfreq;     * Obs to choose from = sum of freq var;
35812     +    end;
35813     +
35814     +    * The remaining observations are equally likely to be chosen       ;
35815     +    ptrials  = 1 / nremain %str(;);
35816     +
35817     +    * Incorporate any frequency variable into probability of selection ;
35818     +    %if %bquote(&_freq) ^=  %then ptrials   = &_freq * ptrials %str(;);
35819     +
35820     +    * Randomly set _resamp_ = number of times to output this obs       ;
35821     +    if ptrials < 1 then call ranbin( seed, ntrials, ptrials, _resamp_);
35822     +    else                _resamp_ = ntrials;
35823     +
35824     +    * Output training observation                                      ;
35825     +    if _resamp_ > 0 then output &_tra;
35826     +
35827     +    * Update number of observations still needed to output             ;
35828     +    ntrials = ntrials - _resamp_;
35829     +
35830     +    * If output enough observatoins, stop.                             ;
35831     +    if ntrials <= 0 then stop;
35832     +
35833     +    * Update number of observations remaining to choose from           ;
35834     +    %if %bquote(&_freq) ^=  %then nremain   = nremain  - &_freq %str(;);
35835     +    %else                         nremain   = nremain  -      1 %str(;);
35836     +
35837     +  run;
35838     +
35839     +%mend embag;
