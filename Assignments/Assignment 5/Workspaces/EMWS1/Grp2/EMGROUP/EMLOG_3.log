227077    +%macro embag(_tra=, _train=, _seed=, _freq=, _sumfreq=, _size=, _loop=);
227078    +  data &_tra;
227079    +    set &_train;
227080    +
227081    +    retain seed nremain ntrials ptrials -1;
227082    +    drop   seed nremain ntrials ptrials;
227083    +
227084    +    * If a frequency variable exists, do not export it                 ;
227085    +    %if %bquote(&_freq) ^=  %then %do;
227086    +        drop &_freq ;
227087    +        if &_freq eq . then return ;
227088    +        if &_freq <= 0 then return ;
227089    +    %end;
227090    +
227091    +    if ntrials lt 0 then do;     * Initialization                      ;
227092    +        seed = &_seed + &_loop;  * Seed depends on loop index          ;
227093    +        ntrials = round(&_size); * Number of observations to select    ;
227094    +        nremain = &_sumfreq;     * Obs to choose from = sum of freq var;
227095    +    end;
227096    +
227097    +    * The remaining observations are equally likely to be chosen       ;
227098    +    ptrials  = 1 / nremain %str(;);
227099    +
227100    +    * Incorporate any frequency variable into probability of selection ;
227101    +    %if %bquote(&_freq) ^=  %then ptrials   = &_freq * ptrials %str(;);
227102    +
227103    +    * Randomly set _resamp_ = number of times to output this obs       ;
227104    +    if ptrials < 1 then call ranbin( seed, ntrials, ptrials, _resamp_);
227105    +    else                _resamp_ = ntrials;
227106    +
227107    +    * Output training observation                                      ;
227108    +    if _resamp_ > 0 then output &_tra;
227109    +
227110    +    * Update number of observations still needed to output             ;
227111    +    ntrials = ntrials - _resamp_;
227112    +
227113    +    * If output enough observatoins, stop.                             ;
