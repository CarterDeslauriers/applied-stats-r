MPRINT(MAIN):   *************************************************************************** ** MACROS FOR DISCOVERING INTERACTION OF INPUTS IN ARBORETUM MODELS ** ** AUTHOR: saspgn ** REVISED: 1 MAY 2007 ** ** REFERENCE: Jerome H. Friedman and Bogdan E.
Popescu ** Predictive Models via Rule Ensembles ** 28 Feb 2005 ***************************************************************************;
50858     +%macro compute_iact_h(data=, model=, outds=);
50860     +/*** NOTE: this macro was modified to also calculation 1 way partial dependency values as well ****/
50862     +***************************************************************************
50863     +** MACRO:     COMPUTE_IACT_H
50864     +** PURPOSE:   ESTIMATE INTERACTION OF INPUT TO ANY OTHER INPUTS IN MODEL
50865     +** AUTHOR:    saspgn
50866     +** DATE:      30 APR 2007
50867     +**
50868     +** ARGUMENTS: DATA=  data with which to evaluate interaction.
50869     +**                   Typically training data.
50870     +**            MODEL= Model data set from SAVE MODEL= option
50871     +**                   of PROC ARBORETUM  (or SPLIT, FOREST, TREEBOOST)
50872     +**            OUTDS= output data set from this macro.
50873     +**                   Contains two variables:
50874     +**                   NAME   containing name of input variable
50875     +**                   H      containing the H statistic for interaction.
50876     +**
50877     +** DETAILS:   In Predictive Models via Rule Ensembles the authors
50878     +**            define statistic Hj that will be greater than 0 to
50879     +**            the extant that input variable j interacts with some
50880     +**            other variable (section 8.1, equation 45 ).
50881     +**            Macro COMPUTE_IACT_H computes Hj for all variables
50882     +**            used as a primary splitting rule in the model.
50883     +**            The computation of interactions is time consuming.
50884     +**            The user might therefore consult Hj before selecting
50885     +**            which interactions to compute.
50886     +**
50887     +** REFERENCE: Jerome H. Friedman and Bogdan E. Popescu
50888     +**                  Predictive Models via Rule Ensembles
50889     +**                  28 Feb 2005
50890     +**                  http://www.stat-stanford.edu/~jhf
50891     +**************************************************************************;
50893     +    %do v=1 %to &ni;
50894     +        proc arbor proc=treeboost inmodel=&model;
50895     +            makemacro importantid=&v  var=var;
50896     +            partialdep data=&data out=vds(keep= p_: &var) var= (&var);
50897     +            partialdep data=&data out=eds(keep= p_:) exceptvar= (&var);
50898     +        quit;
50900     +        %let predvar=;
50901     +        %let dsid=%sysfunc(open(&EM_DEC_DECMETA(where=(_TYPE_='PREDICTED'))));
50902     +        %let varnum =%sysfunc(varnum(&dsid, VARIABLE));
50903     +        %do %while(^ %sysfunc(fetch(&dsid)));
50904     +           %let variable = %sysfunc(getvarc(&dsid, &varnum));
50905     +           %let predvar = &predvar &variable;
50906     +        %end;
50907     +        %let dsid = %sysfunc(close(&dsid));
50909     +        data fds;  set fds;  keep &predvar; run;
50910     +        data vds;  set vds;  keep &predvar; run;
50911     +        data eds;  set eds;  keep &predvar; run;
50914     +        %compute_iact_sub(ds1=fds, ds2=vds, ds3=eds, nc=&nclasses, outds=h);
50916     +        /* generates table same size as training data -- too large to plot; removing for now
50917     +        %generatePartialDependencyTable(iteration=&v, ds1=vds, var=&var); */
50919     +        data h;
50920     +             set h;
50921     +             length name $ 32;
50922     +             name = "&var";
50923     +        run;
50924     +        data &outds;
50925     +          set
50926     +              %if &v ne 1 %then %do;
50927     +                  &outds
50928     +              %end;
50929     +               h;
50930     +        run;
50932     +    %end;
