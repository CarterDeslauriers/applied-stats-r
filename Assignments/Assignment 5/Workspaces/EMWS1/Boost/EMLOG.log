50935     +%macro compute_iact_sub(ds1=, ds2=, ds3=, nc=, outds=);
50937     +        %if &nc eq 0 %then %do;
50938     +             data ads; set &ds1; array r p_:; keep a; a = r(1); run;
50939     +             data bds; set &ds2; array r p_:; keep b; b = r(1); run;
50940     +             data cds; set &ds3; array r p_:; keep c; c = r(1); run;
50941     +             data mds; merge ads bds cds;         run;
50943     +             proc stdize data= mds method=mean out=sds;
50944     +                  var a b c;
50945     +             run;
50947     +             data &outds;
50948     +                 retain ss 0  sf 0;
50949     +                 set sds end=the_end;
50950     +                 keep H;
50952     +                 s = a - b - c;
50953     +                 ss = ss + s*s;
50954     +                 sf = sf + a * a;
50956     +                 if the_end ne 0 then do;
50957     +                    H = ss/sf;
50958     +                    output;
50959     +                 end;
50960     +             run;
50961     +        %end;
50963     +        %else %do;  * categorical response. nclasses > 0 ;
50964     +            data ads;
50965     +                 set &ds1;
50966     +                 array r{*} p_:;
50967     +                 keep a:;
50968     +                 %do j = 1 %to &nclasses;
50969     +                     a&j = r(&j);
50970     +                 %end;
50971     +              run;
50972     +              data bds;
50973     +                 set &ds2;
50974     +                 array r{*} p_:;
50975     +                 keep b:;
50976     +                 %do j = 1 %to &nclasses;
50977     +                     b&j = r(&j);
50978     +                 %end;
50979     +              run;
50980     +              data cds;
50981     +                 set &ds3;
50982     +                 array r{*} p_:;
50983     +                 keep c:;
50984     +                 %do j = 1 %to &nclasses;
50985     +                     c&j = r(&j);
50986     +                 %end;
50987     +              run;
50989     +              data mds;
50990     +                   merge ads bds cds;
50991     +              run;
50992     +              proc stdize data=mds method=mean out=sds;
50993     +                   var a: b: c:;
50994     +              run;
50996     +             data &outds;
50997     +                 retain ss 0  sf 0;
50998     +                 set sds end=the_end;
50999     +                 array ra a:;
51000     +                 array rb b:;
51001     +                 array rc c:;
51002     +                 keep H;
51004     +                 do j = 1 to dim(ra);
51005     +                    s = ra(j) - rb(j) - rc(j);
51006     +                    ss = ss + s*s;
51007     +                    sf = sf + ra(j) * ra(j);
51008     +                 end;
51010     +                 if the_end ne 0 then do;
51011     +                    H = ss/sf;
51012     +                    output;
51013     +                 end;
51014     +            run;
51015     +        %end;
51016     +%mend;
