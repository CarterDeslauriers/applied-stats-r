MPRINT(MAKERESIDUALVARS):   put "and F_diagnosis ne 'B'";
MPRINT(MAKERESIDUALVARS):   put " then do;";
MPRINT(MAKERESIDUALVARS):   put "R_diagnosisM=.;";
