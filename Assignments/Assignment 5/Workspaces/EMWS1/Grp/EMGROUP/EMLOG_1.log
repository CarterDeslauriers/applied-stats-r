43158     +%macro embag(_tra=, _train=, _seed=, _freq=, _sumfreq=, _size=, _loop=);
43159     +  data &_tra;
43160     +    set &_train;
43161     +
43162     +    retain seed nremain ntrials ptrials -1;
43163     +    drop   seed nremain ntrials ptrials;
43164     +
43165     +    * If a frequency variable exists, do not export it                 ;
43166     +    %if %bquote(&_freq) ^=  %then %do;
43167     +        drop &_freq ;
43168     +        if &_freq eq . then return ;
43169     +        if &_freq <= 0 then return ;
43170     +    %end;
43171     +
43172     +    if ntrials lt 0 then do;     * Initialization                      ;
43173     +        seed = &_seed + &_loop;  * Seed depends on loop index          ;
43174     +        ntrials = round(&_size); * Number of observations to select    ;
43175     +        nremain = &_sumfreq;     * Obs to choose from = sum of freq var;
43176     +    end;
43177     +
43178     +    * The remaining observations are equally likely to be chosen       ;
43179     +    ptrials  = 1 / nremain %str(;);
43180     +
43181     +    * Incorporate any frequency variable into probability of selection ;
43182     +    %if %bquote(&_freq) ^=  %then ptrials   = &_freq * ptrials %str(;);
43183     +
43184     +    * Randomly set _resamp_ = number of times to output this obs       ;
43185     +    if ptrials < 1 then call ranbin( seed, ntrials, ptrials, _resamp_);
43186     +    else                _resamp_ = ntrials;
43187     +
43188     +    * Output training observation                                      ;
43189     +    if _resamp_ > 0 then output &_tra;
43190     +
43191     +    * Update number of observations still needed to output             ;
43192     +    ntrials = ntrials - _resamp_;
43193     +
43194     +    * If output enough observatoins, stop.                             ;
43195     +    if ntrials <= 0 then stop;
43196     +
43197     +    * Update number of observations remaining to choose from           ;
43198     +    %if %bquote(&_freq) ^=  %then nremain   = nremain  - &_freq %str(;);
43199     +    %else                         nremain   = nremain  -      1 %str(;);
